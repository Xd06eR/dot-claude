# Allowlist: ignore everything except the paths re-allowed below
*

# Repo files
!.gitattributes
!.gitignore
!LICENSE
!README.md

# Claude Code instructions and config
!CLAUDE.md
!settings.json

# Harness state (the canon)
!CANON.md

# Claude Code component dirs (agents, commands, hooks, rules, skills)
!agents/
!agents/**
!commands/
!commands/**
!hooks/
!hooks/**
!rules/
!rules/**
!skills/
!skills/**

# Probe scripts
!scripts/
!scripts/**
scripts/dumps/

# Harness project rules (nested project-rules dir — auto-loads only when working in this repo)
!.claude/
!.claude/**

# Backup files — never tracked
**/*.bak
