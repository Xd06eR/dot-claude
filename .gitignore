# Allowlist: ignore all root-level files and directories except what we track
*

# Repo files
!.gitattributes
!.gitignore
!README.md

# Claude Code instructions and config
!CLAUDE.md
!RTK.md
!settings.json

# Claude Code extensions (agents, hooks, rules, skills)
!agents/
!agents/**
!commands/
!commands/**
!hooks/
!hooks/**
!rules/
!rules/**
!skills/
!skills/**

# Harness project rules (nested project-rules dir — auto-loads only when working in this repo)
!.claude/
!.claude/**

# Backup files — never tracked
**/*.bak
