# Allowlist: ignore all root-level files and directories except what we track
*

# Repo files
!.gitattributes
!.gitignore
!README.md

# Claude Code instructions and config
!CLAUDE.md
!RTK.md
!TOOLKIT.md
!settings.json

# Claude Code extensions (agents, hooks, rules, skills)
!agents/
!agents/**
!commands/
!commands/**
!hooks/
!hooks/**
!rules/
!rules/**
!skills/
!skills/**

# Backup files — never tracked
**/*.bak

# gstack clone guard — a clone appearing here must never be tracked
skills/gstack/
