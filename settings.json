  "hooks": {
    "PostToolUse": [
      {
        "_gstack_source": "plan-tune-cathedral",
        "hooks": [
          {
            "command": "C:/Users/User/.claude/skills/gstack/hosts/claude/hooks/question-log-hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/block-dangerous-git.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "_gstack_source": "plan-tune-cathedral",
        "hooks": [
          {
            "command": "C:/Users/User/.claude/skills/gstack/hosts/claude/hooks/question-preference-hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)"
      }
    ]
  },
  "statusLine": {
    "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Users\\User\\.claude\\plugins\\cache\\caveman\\caveman\\655b7d9c5431\\src\\hooks\\caveman-statusline.ps1\"",
    "type": "command"
  },
  "teammateMode": "auto",
  "theme": "light"
