{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactEnabled": false,
  "autoMemoryEnabled": false,
  "autoUpdatesChannel": "latest",
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "disableSkillShellExecution": true,
  "disableWorkflows": true,
  "enableArtifact": false,
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "ENABLE_CODE_SECURITY_REVIEW": "0",
    "ENABLE_TOOL_SEARCH": "false"
  },
  "hooks": {
    "PostToolUse": [],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/block-git-gh-mutations.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/block-secret-paths.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "Bash(ls *)",
      "Bash(rtk ls *)",
      "Bash(rtk proxy ls *)",
      "Bash(git status *)",
      "Bash(rtk git status *)",
      "Bash(rtk proxy git status *)",
      "Bash(git log *)",
      "Bash(rtk git log *)",
      "Bash(rtk proxy git log *)",
      "Bash(git diff *)",
      "Bash(rtk git diff *)",
      "Bash(rtk proxy git diff *)",
      "Bash(git show *)",
      "Bash(rtk git show *)",
      "Bash(rtk proxy git show *)",
      "Bash(git blame *)",
      "Bash(rtk git blame *)",
      "Bash(rtk proxy git blame *)",
      "Bash(git ls-files *)",
      "Bash(rtk git ls-files *)",
      "Bash(rtk proxy git ls-files *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(rtk grep *)",
      "Bash(rtk proxy grep *)",
      "Bash(rtk proxy rg *)",
      "Bash(diff *)",
      "Bash(rtk diff *)",
      "Bash(rtk proxy diff *)",
      "Bash(wc *)",
      "Bash(rtk wc *)",
      "Bash(rtk proxy wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(rtk read *)",
      "Bash(rtk proxy cat *)",
      "Bash(rtk proxy head *)",
      "Bash(rtk proxy tail *)",
      "Bash(which *)",
      "Bash(rtk which *)",
      "Bash(rtk proxy which *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(rtk pytest *)",
      "Bash(rtk proxy pytest *)",
      "Bash(vitest *)",
      "Bash(rtk vitest *)",
      "Bash(rtk proxy vitest *)",
      "Bash(jest *)",
      "Bash(rtk jest *)",
      "Bash(rtk proxy jest *)",
      "Bash(tsc --noEmit *)",
      "Bash(rtk tsc --noEmit *)",
      "Bash(rtk proxy tsc --noEmit *)",
      "Bash(npm run lint)",
      "Bash(rtk lint)",
      "Bash(rtk proxy npm run lint)",
      "Bash(npm run test *)",
      "Bash(rtk npm run test *)",
      "Bash(rtk proxy npm run test *)",
      "Bash(uv run pytest *)",
      "Bash(rtk uv run pytest *)",
      "Bash(rtk proxy uv run pytest *)",
      "WebSearch",
      "WebFetch",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_find",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__plugin_playwright_playwright__browser_network_requests",
      "mcp__plugin_playwright_playwright__browser_network_request",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "mcp__plugin_playwright_playwright__browser_close",
      "mcp__plugin_playwright_playwright__browser_resize",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__list_pages",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__list_console_messages",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__list_network_requests",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__get_console_message",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__get_network_request",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_snapshot",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_screenshot",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__wait_for",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_heapsnapshot",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__performance_analyze_insight",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__performance_stop_trace",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__close_page",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__resize_page"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rtk rm *)",
      "Bash(rtk proxy rm *)",
      "Bash(curl *)",
      "Bash(rtk curl *)",
      "Bash(rtk proxy curl *)",
      "Bash(wget *)",
      "Bash(rtk wget *)",
      "Bash(rtk proxy wget *)",
      "Bash(winget *)",
      "Bash(rtk winget *)",
      "Bash(rtk proxy winget *)"
    ],
    "defaultMode": "default",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Bash(rtk run *)",
      "NotebookEdit",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ListAgents",
      "DesignSync",
      "ScheduleWakeup",
      "TaskOutput",
      "TodoWrite",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "ReportFindings",
      "PushNotification",
      "RemoteTrigger",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "skipWebFetchPreflight": true,
  "theme": "light"
}