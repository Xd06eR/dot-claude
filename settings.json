    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "autoUpdate": false,
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "caveman": {
      "autoUpdate": false,
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "impeccable": {
      "autoUpdate": false,
      "source": {
        "repo": "pbakaus/impeccable",
        "source": "github"
      }
    },
    "openai-codex": {
      "autoUpdate": false,
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "ponytail": {
      "autoUpdate": false,
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/block-dangerous-git.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/block-secret-paths.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "Bash(rtk proxy *)",
      "Bash(rtk ls *)",
      "Bash(rtk find *)",
      "Bash(rtk git status *)",
      "Bash(rtk git log *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git show *)",
      "Bash(rtk git blame *)",
      "Bash(rtk git ls-files *)",
      "Bash(rtk grep *)",
      "Bash(rtk diff *)",
      "Bash(rtk wc *)",
      "Bash(rtk read *)",
      "Bash(rtk cat *)",
      "Bash(rtk head *)",
      "Bash(rtk tail *)",
      "Bash(rtk tree *)",
      "Bash(rtk stat *)",
      "Bash(rtk file *)",
      "Bash(rtk which *)",
      "Bash(rtk rg *)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rtk rm *)",
      "Bash(rtk proxy rm *)",
      "Bash(rtk proxy curl *)",
      "Bash(rtk proxy wget *)"
    ],
    "defaultMode": "default",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "skipWebFetchPreflight": true,
  "statusLine": {
    "command": "powershell -ExecutionPolicy Bypass -Command \"& 'C:\\Users\\User\\.claude\\plugins\\cache\\caveman\\caveman\\25d22f864ad6\\src\\hooks\\caveman-statusline.ps1'; [Console]::Write(' '); & 'C:\\Users\\User\\.claude\\plugins\\cache\\ponytail\\ponytail\\4.7.0\\hooks\\ponytail-statusline.ps1'\"",
    "type": "command"
  },
  "teammateMode": "auto",
  "theme": "light"
}